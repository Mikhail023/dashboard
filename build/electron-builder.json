{
  "appId": "local.dashboard.desktop",
  "productName": "Dashboard",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "migrations/**/*",
    "package.json",
    "build/icon.png"
  ],
  "asar": true,
  "asarUnpack": [
    "**/*.node"
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "identity": null,
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "icon": "build/icon.icns"
  },
  "dmg": {
    "title": "Dashboard",
    "contents": [
      {
        "x": 160,
        "y": 180
      },
      {
        "x": 440,
        "y": 180,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "artifactName": "Dashboard-${version}-${arch}.${ext}",
  "publish": [
    {
      "provider": "github",
      "owner": "Mikhail023",
      "repo": "dashboard",
      "releaseType": "release"
    }
  ]
}
